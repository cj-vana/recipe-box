{
  "id": "/",
  "name": "Recipe Box",
  "short_name": "Recipe Box",
  "description": "A private recipe library with cooking history, meal planning, timers, and Kitchen Stock.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#f2ead8",
  "theme_color": "#ad3e2f",
  "orientation": "any",
  "categories": ["food", "lifestyle", "utilities"],
  "icons": [
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    { "name": "Search recipes", "short_name": "Search", "url": "/#top", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Kitchen Stock", "short_name": "Stock", "url": "/#view=stock", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Shopping list", "short_name": "List", "url": "/#view=shopping", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
